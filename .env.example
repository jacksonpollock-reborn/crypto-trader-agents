# Required: the four analysts always run on Claude (config.py -> analyst_llm)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: only read by execution/hyperliquid_executor.py (live order placement is not implemented; paper mode ignores them)
HYPERLIQUID_WALLET_ADDRESS=0xyour-wallet-address-here
HYPERLIQUID_PRIVATE_KEY=your-private-key-here

# Optional: JSON file produced by your own news/social digest pipeline for the sentiment analyst
DIGEST_PATH=/path/to/latest_digest.json

# Optional: override where paper positions and Brier scores are stored (default: logs/position_state.json)
STATE_PATH=logs/position_state.json
